# ─── LLM Provider Fallback Chain ───────────────────────────────────────────────
#
# APEX tries providers in this order, skipping any with no key configured
# (packages/core/src/llm-client.ts is the source of truth):
#
#   Tier 0 (free/credit, tool-reliable, ordered by daily capacity):
#     Mistral (1B tok/mo) -> Gemini x2 (1,500 RPD each) -> Cerebras -> Groq x2 ->
#     SambaNova ($5 credit + 20M TPD) -> Hugging Face (free credits)
#
#   Tier 1 (demoted free capacity): NVIDIA NIM
#   Tier 2 (metered fallback): OpenRouter / Claude Sonnet
#
#   Tier 3 (last resort — unreliable tool calling):
#     OpenRouter/free dynamic router
#
# Two-pass fallback: providers flagged toolCallingReliable=false are skipped
# on tool-bearing requests and only tried as a
# LAST RESORT once every reliable provider has failed. Circuit breakers put
# providers in cooldown after 429/402/401 so concurrent agents don't stampede
# the same exhausted endpoint.
#
# Paid OpenRouter is disabled unless explicitly opted in. Set
# APEX_PAID_LLM_MODE=fallback only when a funded, bounded paid floor is wanted.

# Mistral (La Plateforme) — #1 position, 1B tokens/month free tier.
# Reliable tool calling. Get a key at: https://console.mistral.ai
MISTRAL_API_KEY=

# Groq — permanent free tier, 30 RPM, 14,400 RPD.
# No credit card required. Get a key at: https://console.groq.com
GROQ_API_KEY=
# 2nd Groq account — 2x daily token capacity (100K → 200K TPD). Optional.
GROQ_API_KEY_2=

# Google Gemini — permanent free tier: 1,500 req/day, supports tool calling.
# Get a key at: https://aistudio.google.com
GEMINI_API_KEY=
# 2nd Google Cloud project = separate quota. Optional.
GEMINI_API_KEY_2=

# SambaNova — $5 signup credit, 20M TPD developer tier, OpenAI-compatible.
# Get a key at: https://cloud.sambanova.ai
SAMBANOVA_API_KEY=

# Hugging Face Inference Providers — free inference credits, OpenAI-compatible.
# Get a token at: https://huggingface.co/settings/tokens
HF_TOKEN=

# NVIDIA NIM — free endpoint at build.nvidia.com. Nemotron 3 Nano supports tools.
# Get a key at: https://build.nvidia.com
NVIDIA_API_KEY=

# Stripe — live payment processing for BuildMyBot.app. Used by the Vapi
# webhook handler to create checkout sessions during AI sales calls.
# Get a key at: https://dashboard.stripe.com/apikeys (use sk_live_ for production)
STRIPE_SECRET_KEY=

# OpenRouter — free models plus the bounded paid fallback.
OPENROUTER_API_KEY=

# ─── Model Selection ──────────────────────────────────────────────────────────
#
# Set a model override for providers that honor the requested model:
# APEX_MODEL=provider/model-id
#
# Or set per-role overrides (takes priority over APEX_MODEL):
# APEX_MODEL_CEO=provider/model-id
# APEX_MODEL_LEAD_DEV=provider/model-id

# ─── Agent Behavior ───────────────────────────────────────────────────────────

# strict = gate every agent; normal = role/tool policy (recommended).
# off is rejected at startup so autonomous operation cannot bypass gated tools.
APEX_APPROVAL_MODE=normal

# ─── Resource Governor ───────────────────────────────────────────────────────

# Active safe defaults are shown below. Set a value to 0 only when you
# deliberately want that cap disabled.
#
# APEX_TOKEN_CAP_TOTAL=2000000 was measured throttling production on
# 2026-08-22: the workforce spent 2,160,261 tokens that day and hit the cap at
# ~07:00 UTC, after which complete() fails fast with "spend paused until the
# UTC daily reset" for the remaining 17 hours. The cap was sized well below
# what the free tiers actually hand out — Mistral's free tier alone is ~33M
# tokens/day — so it was capping Apex at roughly 6% of capacity it already
# had. Raise it to reflect real free-tier headroom, and rely on the
# PER-PROVIDER caps below to stop any single provider being drained.
# 30M is a runaway backstop that sits above normal operation rather than
# inside it, and under the sum of the per-provider caps below. Those are the
# caps that should do the real work of spreading load.
APEX_TOKEN_CAP_TOTAL=30000000
APEX_PAID_TOKEN_CAP=250000
APEX_PAID_LLM_MODE=off

# Per-provider daily caps (prompt + completion tokens). These are the caps that
# should do the real work: they spread load so one provider cannot absorb the
# whole day. On 2026-08-22 Mistral took 87% of all traffic and the chain had
# nothing left to fall through to once it capped. Sized to each provider's
# published free tier.
APEX_TOKEN_CAPS=mistral:20000000,google-gemini:1500000,google-gemini-2:1500000,groq:400000,groq-2:400000,sambanova:8000000,huggingface:500000,nvidia:1000000

# Smooth the 13-agent workforce against provider RPM limits and keep each turn
# concise. Per-role overrides use APEX_MAX_OUTPUT_TOKENS_<ROLE>.
APEX_MAX_CONCURRENT_LLM_CALLS=3
APEX_MAX_OUTPUT_TOKENS=2048
# APEX_MAX_OUTPUT_TOKENS_CEO=4096

# adaptive reviews prose-only work and unverified delegation without adding an
# extra model call after every task that already executed concrete tools.
APEX_SELF_REVIEW=adaptive

# Experimental only. Keep false while Lightsail/Postgres owns the production
# scheduler; enabling both runtimes creates duplicate autonomous work.
APEX_CONVEX_AUTONOMY_ENABLED=false

# ─── Workspace ────────────────────────────────────────────────────────────────

# Directory agents can read and write files in.
# Defaults to the current working directory if not set.
# WORKSPACE_ROOT=C:\path\to\your\project

# ─── Database ─────────────────────────────────────────────────────────────────

# Postgres (Supabase) connection string. Schema is bootstrapped idempotently
# at startup — no separate migration step needed (lib/db/src/client.ts).
# Local dev default: postgres://postgres:postgres@localhost:5432/apex
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/apex

# Set to 'true' to log all SQL queries to console
DB_LOGGING=false

# ─── BuildMyBot Connector (optional) ─────────────────────────────────────────
#
# When all of these are set, APEX gains command-and-supervision tools over the
# BuildMyBot.app AI workforce.
#
# NEVER commit real values. The service key is server-side only.

# BUILDMYBOT_SUPABASE_URL=https://evkjlnbpntimbxklnhoz.supabase.co
# BUILDMYBOT_SUPABASE_SERVICE_KEY=
# BUILDMYBOT_APP_URL=https://www.buildmybot.app
# BUILDMYBOT_CRON_SECRET=
# BUILDMYBOT_VERCEL_DEPLOY_HOOK=

# ─── CaseBuddy Connector (optional) ─────────────────────────────────────────
#
# When these are set, APEX gains command-and-supervision tools over the
# CaseBuddy legal AI platform (casebuddy.live). APEX can read cases, monitor
# client intakes, deploy the firm (dispatch all 8 agents on a case), review
# work products, and health-check the deployed product.
#
# CASEBUDDY_SYSTEM_USER_ID is a CaseBuddy user UUID that APEX uses to create
# firm_runs. Create a dedicated user in CaseBuddy's Supabase auth for APEX,
# or use an existing firm admin's UUID.
#
# NEVER commit real values. The service key is server-side only.

# CASEBUDDY_SUPABASE_URL=
# CASEBUDDY_SUPABASE_SERVICE_KEY=
# CASEBUDDY_APP_URL=https://casebuddy.live
# CASEBUDDY_SYSTEM_USER_ID=

# ─── TubeScribe Connector (optional) ──────────────────────────────────────────
#
# Gives APEX read-only monitoring authority over the TubeScribe platform
# (YouTube video analysis + forensic transcription; repo insightful-tube-explorer).
# Tools: tubescribe_status, tubescribe_recent_analyses, tubescribe_supadata_keys
# (key-pool health from the supadata_key_status table the worker populates on
# quota events), tubescribe_supadata_live (real-time quota via the worker's
# GET /supadata-status, probes Supadata /me per key), tubescribe_health_check,
# tubescribe_custody_log. READ-ONLY by design — APEX has no deploy authority over
# TubeScribe; Supadata keys live in the worker's env (SUPADATA_API_KEY /
# SUPADATA_API_KEY_N), and APEX sees only last-4 fingerprints, never raw keys.
# Leave unset to run APEX standalone.
#
# Requires the TubeScribe migration 20260727120000_supadata_key_telemetry.sql
# applied to the TubeScribe Supabase project. NEVER commit real values.
# TUBESCRIBE_SUPABASE_URL=https://wrsrjnqolfytzwbgbkgb.supabase.co
# TUBESCRIBE_SUPABASE_SERVICE_KEY=
# TUBESCRIBE_WORKER_URL=https://insightful-tube-explorer-production.up.railway.app

# ─── Business Search APIs ─────────────────────────────────────────────────────
# Used by the searchBusinessDirectory tool (returns 20 businesses per call
# with phone + website). Multi-provider: Yelp → Google Places → OSM fallback.
# Yelp is free (no credit card): https://www.yelp.com/developers
# YELP_API_KEY=
# GOOGLE_PLACES_API_KEY=

# ─── GitHub (engineering loop) ────────────────────────────────────────────────
#
# Personal access token used by the create_pull_request / push_to_remote tools
# to land buildmybot2 (and Apex) engineering work via branch-protected PRs.
# Without it, the autonomous engineering loop cannot open PRs. Code always lands
# through PRs — never direct pushes to main. The value provisioned here is the
# GITHUB_TOKEN_4 secret from the vault. NEVER commit the real value.
# GITHUB_TOKEN=

# ─── Vapi.ai — Outbound AI Phone Calls ────────────────────────────────────────
#
# Enables the make_outbound_call tool — lets the Sales agent actually dial
# prospects with an AI voice agent. Sign up at https://dashboard.vapi.ai,
# purchase a phone number, and create a private API key.
#
# VAPI_API_KEY=          # Private API key from dashboard.vapi.ai
# VAPI_PHONE_NUMBER_ID=  # ID of the Vapi-purchased phone number (caller ID)
# VAPI_WEBHOOK_SECRET=   # Optional: shared secret for webhook verification
# VAPI_WEBHOOK_URL=      # Optional: override webhook URL (defaults to https://apex.donmatthews.live/api/vapi/webhook)

# ─── Server ───────────────────────────────────────────────────────────────────

PORT=5000
