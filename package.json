{
  "name": "workspace",
  "version": "0.0.0",
  "packageManager": "pnpm@11.19.0",
  "license": "MIT",
  "scripts": {
    "build": "pnpm run typecheck:production && pnpm --filter @workspace/dashboard run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:production",
    "typecheck:production": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./packages/**\" --filter \"./scripts\" --filter \"!@workspace/convex-backend\" --filter \"!@workspace/apex-cicd-worker\" --if-present run typecheck",
    "typecheck:experimental": "pnpm --filter @workspace/convex-backend --filter @workspace/apex-cicd-worker --if-present run typecheck",
    "verify:lead-contact-enrichment": "node packages/core/node_modules/tsx/dist/cli.mjs scripts/verify-lead-contact-enrichment.ts",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "dev:dashboard": "pnpm --filter @workspace/dashboard run dev",
    "dev": "concurrently \"pnpm run dev:api\" \"pnpm run dev:dashboard\"",
    "verify:specialist-swarm": "node packages/core/node_modules/tsx/dist/cli.mjs scripts/verify-specialist-swarm.ts"
  },
  "private": true,
  "devDependencies": {
    "concurrently": "catalog:",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1134.0",
    "@aws-sdk/s3-request-presigner": "^3.1134.0",
    "dotenv": "^16.6.1",
    "mammoth": "^1.12.3"
  }
}
