# ─── APEX Free-First Intelligence Stack ───────────────────────────────────────
# packages/core/src/llm-client.ts is the source of truth.
# All APEX units use the same route:
#
#   Gemini 3.7 Flash (FREE project)
#   -> Groq GPT-OSS 120B (FREE plan only)
#   -> Cohere Command A+ (free until Cohere free rate limit)
#   -> Poolside Laguna S 2.1 (limited-time free; explicit confirmation)
#   -> Qwen 3.7 Max (Alibaba Free quota only must be enabled)
#   -> Kilo Auto Free
#   -> Mistral Medium 3.5 (PAID emergency fallback; OFF by default)
#
# Cost policy: free/included inference first. A large provider rate limit is NOT
# treated as free capacity. Mistral is last and cannot be called unless
# APEX_PAID_LLM_MODE is deliberately enabled.

# 1) Gemini 3.7 Flash — use API keys from projects that are genuinely on the
# Gemini FREE usage tier. Do not paste a key from a billing-enabled project here.
GEMINI_FREE_API_KEY=
# Optional second genuinely-free Google project key.
GEMINI_FREE_API_KEY_2=

# 2) Groq GPT-OSS 120B — Groq Free plan currently publishes 1,000 RPD and
# 200,000 TPD for openai/gpt-oss-120b. Use a key from a genuinely FREE Groq
# project/account here; do not reuse a billing-enabled Developer-tier key.
GROQ_FREE_API_KEY=
GROQ_FREE_TIER_CONFIRMED=false

# 3) Cohere Command A+ — Cohere currently states Command A+ is free until its
# applicable API rate limit is reached.
COHERE_API_KEY=

# 4) Poolside Laguna S 2.1 — Poolside currently advertises limited-time free
# API access. This confirmation is deliberately required so an old config
# cannot silently keep using Poolside after the promotion changes.
POOLSIDE_API_KEY=
POOLSIDE_FREE_ACCESS_CONFIRMED=false

# 5) Qwen 3.7 Max — Alibaba Model Studio new-user free quota can automatically
# turn into PAYG unless "Free quota only" is enabled in the Model Studio console.
# Enable that provider-side protection FIRST, then set this confirmation true.
QWEN_API_KEY=
# Optional: Singapore shared compatible endpoint is used when this is blank.
# A workspace-specific Singapore URL is preferred when available.
QWEN_BASE_URL=
QWEN_FREE_QUOTA_ONLY=false

# 6) Kilo Auto Free — Kilo's free-routing tier, not Auto Frontier.
KILO_API_KEY=

# 7) Mistral Medium 3.5 — paid emergency fallback only. The key may exist while
# remaining completely unused as long as APEX_PAID_LLM_MODE=off.
MISTRAL_API_KEY=
APEX_PAID_LLM_MODE=off

# ─── Agent Behavior ───────────────────────────────────────────────────────────
# strict = gate every agent; normal = role/tool policy (recommended).
# off is rejected at startup so autonomous operation cannot bypass gated tools.
APEX_APPROVAL_MODE=normal

# ─── Resource Governor ────────────────────────────────────────────────────────
# Free providers should normally stop on THEIR free quota/rate-limit boundary.
# Groq's current Free-plan GPT-OSS 120B TPD is mirrored as a proactive APEX cap
# so we fall through before attempting traffic beyond the published free pool.
# Paid Mistral is disabled separately above.
APEX_TOKEN_CAP_TOTAL=0
APEX_TOKEN_CAPS=groq:200000

# Smooth the 13-agent workforce against provider RPM limits.
APEX_MAX_CONCURRENT_LLM_CALLS=3
APEX_MAX_OUTPUT_TOKENS=2048
# APEX_MAX_OUTPUT_TOKENS_CEO=4096

# adaptive reviews prose-only work and unverified delegation without adding an
# extra model call after every task that already executed concrete tools.
APEX_SELF_REVIEW=adaptive

# Experimental only. Keep false while Lightsail/Postgres owns production.
APEX_CONVEX_AUTONOMY_ENABLED=false

# ─── Workspace ────────────────────────────────────────────────────────────────
# WORKSPACE_ROOT=C:\path\to\your\project

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/apex
DB_LOGGING=false

# ─── BuildMyBot Connector (optional) ─────────────────────────────────────────
# BUILDMYBOT_SUPABASE_URL=https://evkjlnbpntimbxklnhoz.supabase.co
# BUILDMYBOT_SUPABASE_SERVICE_KEY=
# BUILDMYBOT_APP_URL=https://www.buildmybot.app
# BUILDMYBOT_CRON_SECRET=
# BUILDMYBOT_VERCEL_DEPLOY_HOOK=

# ─── CaseBuddy Connector (optional) ───────────────────────────────────────────
# CASEBUDDY_SUPABASE_URL=
# CASEBUDDY_SUPABASE_SERVICE_KEY=
# CASEBUDDY_APP_URL=https://casebuddy.live
# CASEBUDDY_SYSTEM_USER_ID=

# ─── TubeScribe Connector (optional, read-only monitoring) ────────────────────
# TUBESCRIBE_SUPABASE_URL=https://wrsrjnqolfytzwbgbkgb.supabase.co
# TUBESCRIBE_SUPABASE_SERVICE_KEY=
# TUBESCRIBE_WORKER_URL=

# ─── Business Search APIs ─────────────────────────────────────────────────────
# YELP_API_KEY=
# GOOGLE_PLACES_API_KEY=
# TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=

# ─── GitHub (engineering loop) ────────────────────────────────────────────────
# GITHUB_TOKEN=

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=

# ─── Vapi.ai — Outbound AI Phone Calls ────────────────────────────────────────
# VAPI_API_KEY=
# VAPI_PHONE_NUMBER_ID=
# VAPI_WEBHOOK_SECRET=
# VAPI_WEBHOOK_URL=

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
