# Dependencies
node_modules/
.pnpm-store/

# Logs
*.log

# Environment variables
.env
.env.local
*.env.*

# Build output
# TypeScript incremental caches and compiled bundles are regenerated by
# `pnpm typecheck` / `pnpm build`. They are machine-specific and were dirtying
# the tree on every build. lib/db/dist IS tracked deliberately (the Docker
# build consumes it prebuilt) so it is excluded from the dist rule below.
*.tsbuildinfo
packages/*/dist/
