# ─── APEX Production Intelligence Stack ─────────────────────────────────────
# packages/core/src/llm-client.ts is the source of truth.
# APEX uses independent request pools: OpenRouter first, then direct Groq BYOK,
# then direct Gemini BYOK when enabled. A separate emergency ceiling caps the
# combined traffic across every provider.
#
# OpenRouter zero-cost production order:
#   1. nex-agi/nex-n2.5-mini:free
#   2. nex-agi/nex-n2.5-pro:free
#   3. nvidia/nemotron-3-super-120b-a12b:free
#   4. nvidia/nemotron-3.5-lightning:free
#   5. openrouter/free
#   6. nvidia/nemotron-3-ultra-550b-a55b:free
#
# Every configured OpenRouter inference credential is load-balanced by account
# fingerprint. Distinct qualifying accounts add their own free-tier capacity;
# multiple keys from the same account still share one bucket.

OPENROUTER_FREE_API_KEY=
# Optional additional independent-account keys. Account-level balance/rate limits
# still apply when two names hold keys for the same OpenRouter account.
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_API_KEY_4=

# Optional OpenRouter MANAGEMENT keys — one per independent account. These
# cannot run inference. They list (and, by operator action only, create/rotate)
# inference keys so APEX can prove each live key belongs to a distinct account.
# Bind as GitHub / Cloud Run secrets. Never commit the values. Never paste them
# into chat logs.
# OPENROUTER_MGMT_KEY=
# OPENROUTER_MGMT_KEY_2=
# OPENROUTER_MGMT_KEY_3=
# OPENROUTER_MGMT_KEY_4=

# ─── Admin authentication ────────────────────────────────────────────────────
# Required for dashboard/API login. Configure these as deployment secrets;
# there is deliberately no credential fallback in source.
APEX_ADMIN_PASSWORD=
APEX_ADMIN_TOKEN=

# Optional, narrowly-scoped credential for a third-party voice platform (Vapi)
# to call POST /api/sales-ops/sms/send from its own tool-calling — that route
# only, nothing else the admin token can do. Generate any long random string;
# it is never derived from APEX_ADMIN_TOKEN.
APEX_VAPI_SMS_TOKEN=

# ─── Agent Behavior ──────────────────────────────────────────────────────────
# strict = gate every agent; normal = role/tool policy (recommended).
APEX_APPROVAL_MODE=normal

# Standing operator authorization (2026-09-21): approve all gated actions until
# further notice. Set false to immediately restore normal hard-gate behavior.
APEX_OPERATOR_AUTO_APPROVE_ALL=true

# ─── Production Resource Governor ────────────────────────────────────────────
# 0 = no APEX-wide daily token ceiling. Set a positive value when you want a
# deliberate workspace spend ceiling; OpenRouter account controls remain the
# authoritative billing limit.
APEX_TOKEN_CAP_TOTAL=0
# Optional comma-separated caps, e.g. provider:tokens. Leave unset unless you
# want a secondary token ceiling. Inference remains $0; exhaustion pauses APEX.
APEX_TOKEN_PACING_ENABLED=true
APEX_TOKEN_PACING_BURST_TOKENS=50000

# ─── Daily REQUEST budget ────────────────────────────────────────────────────
# Separate from the token caps above, and usually the one that actually binds.
# OpenRouter's free allowance is rationed per REQUEST — a fixed number of calls
# per account per UTC day whatever their size — so a workspace can sit far under
# every token cap it owns and still be refused.
#
# APEX's operator ceiling for the OpenRouter pool is exactly 2,775/day. Each
# OpenRouter account is still independently capped below; 2,775 never grants an
# individual account more requests than OpenRouter itself allows.
APEX_REQUEST_CAP_TOTAL=2775
APEX_REQUEST_PACING_ENABLED=true
APEX_REQUEST_PACING_BURST=50
APEX_REQUEST_RATE_PER_MIN=8
# After a provider-capacity pause, reserve each newly released claim for these
# revenue agents first. Other agents may claim after the bounded grace window,
# so an empty lead queue never strands capacity.
APEX_CAPACITY_PRIORITY_AGENTS=apex-lead-research-001
APEX_CAPACITY_PRIORITY_GRACE_MS=8000
# APEX_REQUEST_CAPS=OPENROUTER_FREE_API_KEY:1000,OPENROUTER_API_KEY:1000,OPENROUTER_API_KEY_2:1000,OPENROUTER_API_KEY_3:1000,OPENROUTER_API_KEY_4:1000

# ─── Paid FlashX continuity ───────────────────────────────────────────────────
# The one operator lever over paid spend. Unset or true keeps the reviewed
# behavior: GLM 5.3 FlashX is last in the chain and unrestricted by
# APEX-specific spend-cap, request-cap, token-cap, or pacing controls, with
# OpenRouter/Z.ai account billing and upstream rate limits authoritative.
#
# false removes the route from the chain entirely and APEX becomes free-only:
# when the free pool and BYOK capacity are spent the workforce parks until the
# daily reset instead of spending money. Nothing else changes -- no free or
# BYOK provider is removed. Use this rather than unsetting OPENROUTER_API_KEY,
# which is also a free-pool account and would cost free capacity too.
APEX_PAID_FALLBACK_ENABLED=true
#
# These legacy spend variables are retained only for telemetry/dashboard
# compatibility. They DO NOT gate FlashX routing.
APEX_DAILY_SPEND_USD=0
APEX_SPEND_PACING_ENABLED=false
APEX_SPEND_PACING_BURST_USD=0
# Request pacing values are defined with the request budget above.
# Short-window rate limit, and NOT redundant with the daily cap: the ramp above
# bounds the day's total but not its rate, so a deploy at 17:20 UTC starts with
# ~2,000 requests already accrued and unspent. On 2026-09-12 that let APEX issue
# 1,388 requests in 26 minutes, trip OpenRouter's per-minute limiter, and park
# every provider until the UTC reset — under budget for the day, total outage in
# practice. 15/min sits below the typical free-tier ceiling with headroom for
# the retry a failure triggers. 0 disables it.
# APEX_REQUEST_RATE_PER_MIN is defined with the request budget above.
# MORE ACCOUNTS IS THE ONLY WAY TO BUY MORE FREE THROUGHPUT. OpenRouter's free
# allowance is a per-ACCOUNT daily request budget shared across every :free model
# at once, not a per-model limit — so adding more free MODELS buys nothing, while
# adding a key for another account adds that account's qualifying free-tier
# capacity. OPENROUTER_API_KEY_3 and OPENROUTER_API_KEY_4 are both valid
# expansion slots and are automatically included in load balancing and health
# telemetry. Duplicate keys/accounts are collapsed by fingerprint.

# Optional per-ACCOUNT caps. Written against env var names, but resolved to the
# account each key belongs to — APEX reads all five configured OpenRouter key
# slots and resolves their real account identity, so names sharing one account are ONE account and
# the strictest cap among them applies. Check the `accounts[]` labels on /health
# to see which names resolve together before setting these.
# An account that hits its cap steps aside while the others keep serving.
# APEX_REQUEST_CAPS=OPENROUTER_API_KEY:1000,OPENROUTER_API_KEY_2:1000

# Agents are instructed to batch independent tool calls into one reply, which
# only works if the request permits more than one call per turn. Sent ONLY to
# models whose OpenRouter catalog entry advertises parallel_tool_calls -- no
# free model currently does, so on the free-only chain this is inert and each
# tool round trip costs its own request. Set to `off` to disable it entirely.
APEX_PARALLEL_TOOL_CALLS=on

# One process-wide inference slot per current APEX agent by default. This keeps
# all 13 units eligible to reason concurrently. The runtime still has a finite
# semaphore (configurable up to 64) to prevent a runaway task storm.
APEX_MAX_CONCURRENT_LLM_CALLS=13
APEX_LEAD_RESEARCH_CONCURRENCY=3
# Default remains conservative. This may be raised as high as 131072 for
# FlashX; free/BYOK providers are clamped to their own smaller envelopes.
APEX_MAX_OUTPUT_TOKENS=4096
# APEX_MAX_OUTPUT_TOKENS_CEO=8192
# APEX_MAX_OUTPUT_TOKENS_CTO=8192

APEX_SELF_REVIEW=adaptive

# Experimental only. Keep false while the primary production database/runtime
# remains outside the unfinished Convex migration.
APEX_CONVEX_AUTONOMY_ENABLED=false

# ─── Google Cloud Run deployment ─────────────────────────────────────────────
# Fail-closed by default. Setting project/region/service does not itself permit
# a deploy; APEX_DEPLOY_ENABLED must also explicitly authorize the environment.
APEX_DEPLOY_ENABLED=off
APEX_GCP_PROJECT_ID=
APEX_CLOUD_RUN_REGION=
APEX_CLOUD_RUN_SERVICE=
# Optional if Cloud Build uses a regional endpoint.
# APEX_CLOUD_BUILD_REGION=
APEX_DEPLOY_HEALTH_URL=https://apex.donmatthews.live
# Optional clean checkout path used by the deployment CLI.
# APEX_DEPLOY_SOURCE_DIR=/path/to/Apex

# ─── Workspace / Database ────────────────────────────────────────────────────
# WORKSPACE_ROOT=/path/to/workspace
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/apex
DB_LOGGING=false

# ─── Durable artifact store (autonomous-execution scheduler, Phase 1) ─────────
# GCS bucket in the existing GCP project/region (gcloud storage buckets create
# gs://<name> --location=<region>). Names only — real values are operator
# configuration, never guessed. When unset every artifact/workspace tool fails
# closed with an actionable error; the control plane keeps running.
APEX_ARTIFACT_BUCKET=
# Railway-native alternative to GCS: a mounted volume directory. If this is
# set, artifact tools write files here instead of GCS.
# APEX_ARTIFACT_DIR=/data/artifacts
# Sandbox executor (Phase 4): Cloud Run Jobs resource name. On Railway, leave
# unset and keep APEX_EXECUTOR_MODE=inprocess so heavy tasks run in the worker
# instead of waiting forever for gcloud.
APEX_EXECUTOR_JOB=
# APEX_EXECUTOR_MODE=inprocess
# Workstream repo org used by create_github_repo (default patriotnewsactivism).
# APEX_GITHUB_ORG=patriotnewsactivism
# Dynamic-job governance (Phase 5): ceiling for agent-created crons (min 5).
# APEX_MAX_DYNAMIC_JOBS=25
# Executor tuning.
# EXECUTOR_MAX_TURNS=40
# EXECUTOR_TASK_HARD_TIMEOUT_MS=3300000
# EXECUTOR_ALLOW_RUNSHELL=false

# ─── Checkpoint/resume and approval yield (ADR-014) ───────────────────────────
# Fraction of the hard task timeout at which a task must checkpoint and yield
# instead of continuing to burn its execution slot. Clamped to [0.3, 0.95].
# APEX_SOFT_TIMEOUT_RATIO=0.7
# Ordinary (non-executor-job) hard wall-clock timeout override, in ms. The
# executor-job ceiling is EXECUTOR_TASK_HARD_TIMEOUT_MS above.
# APEX_TASK_HARD_TIMEOUT_MS=600000
# How long a gated approval may sit unanswered before it is durably
# auto-rejected (never auto-approved). 0 disables the expiry entirely.
# APEX_APPROVAL_AUTO_REJECT_HOURS=24

# ─── Base44 Superagent Connector (optional) ──────────────────────────────────
# Server-side secret only. Never expose this with VITE_/NEXT_PUBLIC_ prefixes.
# Rotate any key that has been pasted into chat, logs, screenshots, or source.
BASE44_SUPERAGENT_API_KEY=
BASE44_SUPERAGENT_ID=6a515f4e071e32fc10378575
BASE44_SUPERAGENT_TIMEOUT_MS=90000

# ─── BuildMyBot Connector (optional) ─────────────────────────────────────────
# BuildMyBot is Neon/Postgres-backed. APEX service health uses /api/health and
# does not require database credentials; the database URL is only for managed
# data-plane tools that intentionally need direct Neon access.
# BUILDMYBOT_APP_URL=https://www.buildmybot.app
# BUILDMYBOT_DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require
# BUILDMYBOT_CRON_SECRET=
# BUILDMYBOT_RAILWAY_TOKEN=
# BUILDMYBOT_RAILWAY_SERVICE_ID=60b6d260-f5d8-463d-87be-58339545eaaf
# BUILDMYBOT_RAILWAY_ENVIRONMENT_ID=6ce38db0-789b-4fe9-ad02-f068fe6866ae

# ─── CaseBuddy Connector (optional) ──────────────────────────────────────────
# CASEBUDDY_SUPABASE_URL=
# CASEBUDDY_SUPABASE_SERVICE_KEY=
# CASEBUDDY_APP_URL=https://casebuddy.live
# CASEBUDDY_SYSTEM_USER_ID=

# ─── TubeScribe Connector (optional, read-only monitoring) ───────────────────
# TUBESCRIBE_SUPABASE_URL=
# TUBESCRIBE_SUPABASE_SERVICE_KEY=
# TUBESCRIBE_WORKER_URL=

# ─── Direct BYOK LLM capacity ────────────────────────────────────────────────
# These are separate provider credential pools exposed in APEX Settings.
# They do not automatically increase OpenRouter's 2,775/day allowance; direct
# Qwen/Gemini/Groq routing is metered separately when enabled.
#
# QwenCloud Token Plan (qwencloud.com — NOT Alibaba Cloud DashScope, a
# different product with different credentials): PRIMARY route, tried before
# the free OpenRouter chain — the operator holds a paid Token Plan
# subscription and wants it used rather than left idle. Still governed by its
# own capped/paced pool below; this is NOT the unrestricted FlashX-style
# bypass. Token Plan keys (`sk-sp-...`) only work with the Token Plan base
# URL, not the separate pay-as-you-go endpoint/keys (`sk-ws-...`). Cap/rate
# defaults below are a conservative placeholder, not a verified quota —
# confirm the real plan limits in the QwenCloud console and adjust. See
# docs/ARCHITECTURE_DECISIONS.md ADR-017.
QWEN_BASE_URL=https://token-plan.maas.qwencloudapi.com/compatible-mode/v1
APEX_QWEN_BYOK_ENABLED=true
APEX_QWEN_REQUEST_CAP=2500
APEX_QWEN_REQUEST_RATE_PER_MIN=25
APEX_QWEN_REQUEST_PACING_BURST=50
# APEX_QWEN_BASE_URL=https://token-plan.maas.qwencloudapi.com/compatible-mode/v1
# APEX_QWEN_MAX_OUTPUT_TOKENS=8192
QWEN_API_KEY=
QWEN_API_KEY_2=
#
# Groq: independent APEX pool. Production keeps 10% headroom beneath the
# provider's base 1,000-RPD GPT-OSS allowance for voice/out-of-process traffic.
APEX_GROQ_BYOK_ENABLED=true
APEX_GROQ_REQUEST_CAP=900
APEX_GROQ_REQUEST_RATE_PER_MIN=8
APEX_GROQ_REQUEST_PACING_BURST=25
GROQ_API_KEY=
GROQ_API_KEY_2=
#
# Gemini: independent pool using the native Interactions API. Exact quotas are
# project/model/tier specific, so start conservatively and only enable after the
# Settings credential probe / a real Interactions request succeeds.
APEX_GEMINI_BYOK_ENABLED=false
APEX_GEMINI_REQUEST_CAP=500
APEX_GEMINI_REQUEST_RATE_PER_MIN=5
APEX_GEMINI_REQUEST_PACING_BURST=20
GEMINI_API_KEY=
GEMINI_API_KEY_2=
#
# Emergency stop for free OpenRouter + direct BYOK traffic (Qwen, Groq,
# Gemini). The operator-approved paid GLM 5.3 FlashX continuity route bypasses
# this APEX ceiling.
APEX_EMERGENCY_REQUEST_CAP_TOTAL=4500

# ─── Business Search APIs ────────────────────────────────────────────────────
# YELP_API_KEY=
# GOOGLE_PLACES_API_KEY=
# TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=

# ─── GitHub / Business Integrations ──────────────────────────────────────────
# GITHUB_TOKEN=
STRIPE_SECRET_KEY=
# VAPI_API_KEY=
# VAPI_PHONE_NUMBER_ID=
# VAPI_WEBHOOK_SECRET=
# VAPI_WEBHOOK_URL=

# ─── Telnyx Voice (BuildMyBot inbound calls) ─────────────────────────────────
# Required for the Telnyx ↔ Deepgram voice bridge (inbound BuildMyBot calls).
# DEEPGRAM_API_KEY is also used by the /api/transcribe route above.
# TELNYX_API_KEY=
# TELNYX_WEBHOOK_SECRET=          # shared secret verified on every Telnyx webhook
# TELNYX_OWNER_NUMBER=+1xxxxxxxxxx # E.164 number for transfer_to_owner
# TELNYX_MESSAGING_NUMBER=+1xxxxxxxxxx # Telnyx number that sends the SMS checkout link
# PUBLIC_URL=https://apex.donmatthews.live  # base URL for the stream WebSocket

# ─── Apex Front Desk (Telnyx-hosted AI Assistant) ────────────────────────────
# Backs the "Apex Front Desk" assistant configured directly in the Telnyx
# account (not in this repo — Telnyx hosts the voice/STT/LLM/TTS loop).
# routes/telnyx-assistant.ts is only the custom tool-calling surface it uses.
# TELNYX_ASSISTANT_WEBHOOK_SECRET=  # query-string key verified on every request from the assistant
# APEX_FRONT_DESK_NUMBER=+1xxxxxxxxxx  # the Telnyx number the assistant answers on; also the SMS "from"
# Live-call escalation transfer is configured as a native `transfer` tool
# directly on the Telnyx assistant (a fixed, pre-defined target list Telnyx
# executes itself) — not an Apex-side secret, so there is nothing to set here.

# ─── Live Voice (browser/admin Live Talk) ────────────────────────────────────
# packages/api-server/src/live-voice.ts — the "Live voice call" button in the
# dashboard's Chat window (distinct from all Telnyx/PSTN voice paths).
#
# Preferred path: direct persistent Gemini 3.8 Live WebSocket using
# GEMINI_API_KEY above. Full-duplex microphone audio stays open during model
# speech; Gemini handles native start-of-activity interruption and async tools.
# Long-running work is dispatched to the APEX swarm rather than blocking the
# realtime conversation.
#
# Compatibility fallback: if Gemini cannot reach setupComplete, the same
# browser call falls back to Deepgram Voice Agent + Groq + ElevenLabs/Aura.
# This preserves availability for projects/accounts that still lack Live API
# access. Set APEX_LIVE_VOICE_PROVIDER=deepgram only to force that fallback
# while diagnosing Gemini; otherwise the default is "gemini".
# APEX_LIVE_VOICE_PROVIDER=gemini
# DEEPGRAM_API_KEY=
# GROQ_API_KEY=
# GROQ_API_KEY_2=

# ─── ElevenLabs (voice realism, 2026-09-25) ──────────────────────────────────
# Used by Vapi outbound/inbound phone calls (make_outbound_call /
# configure_inbound_assistant in tool-registry.ts — Vapi holds its own
# ElevenLabs relationship), inbound BuildMyBot calls
# (telnyx-deepgram-agent.ts), and the Deepgram compatibility fallback for
# browser Live Talk. Direct Gemini Live uses Gemini's native audio output and
# does not route browser audio through ElevenLabs. Where the Deepgram path is
# active, ELEVENLABS_API_KEY is optional; without it Deepgram Aura remains the
# functional fallback.
# ELEVENLABS_VOICE_ID defaults to the same stock voice already live on Vapi
# calls (21m00Tcm4TlvDq8ikWAM) so Apex sounds like the same person everywhere.
# Override it once a specific cloned/premium voice is connected to your
# ElevenLabs account — for Vapi this also requires connecting that account in
# Vapi's own dashboard under Integrations (see docs.vapi.ai/providers/voice/elevenlabs).
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# ─── Call Bridge (operator call + live AI takeover) ──────────────────────────
# Bridges the operator's own phone with a customer's via a Telnyx conference
# (see routes/call-bridge.ts), with an option to bring the Apex Front Desk
# assistant in live. Needs its own Call Control Application (not the Front
# Desk number's TeXML app) because it drives calls imperatively via the Call
# Control REST API rather than a declarative TeXML/AI-Assistant script.
# TELNYX_CALL_BRIDGE_CONNECTION_ID=  # id of a dedicated Call Control Application
# TELNYX_CALL_BRIDGE_WEBHOOK_SECRET=  # query-string key verified on every call-bridge webhook

# ─── Error reporting (Sentry) ────────────────────────────────────────────────
# Leave empty in source. Set SENTRY_DSN on Railway service apex-backend for
# production capture. The API server skips Sentry init when this is missing.
SENTRY_DSN=
# Optional. Falls back to NODE_ENV, then "development".
SENTRY_ENVIRONMENT=

PORT=5000

# Turn Economy: only enqueues carrying context.bundleKey opt in. Interactive,
# urgent, priority 1-2, executor, checkpoint and deterministic tasks bypass it.
APEX_WORK_BUNDLES_ENABLED=false
APEX_BUNDLE_WINDOW_MS=10000
# Shared across credentials confirmed to belong to the same account. 0 disables.
# The existing workspace RPM ceiling still applies independently.
APEX_ACCOUNT_REQUEST_RATE_PER_MIN=15
