# ─── APEX Production Intelligence Stack ─────────────────────────────────────
# packages/core/src/llm-client.ts is the source of truth.
# All APEX units route through OpenRouter.
#
# Production LLM order: DeepSeek V4 Flash 0731 -> GPT-OSS 120B -> DeepSeek V3.2 -> Grok 4.6 via pinned Bedrock BYOK.
# OpenRouter :free endpoints are experiment-only and are not valid persisted production routes.

OPENROUTER_API_KEY=
# Optional credential redundancy. This may be a second key; account-level
# balance/rate limits still apply when both keys belong to the same account.
OPENROUTER_API_KEY_2=
# Optional separately named paid fallback credential. The normal paid fallback
# also uses OPENROUTER_API_KEY, so this is not required when that key is funded.
OPENROUTER_API_KEY_3=

# ─── Admin authentication ────────────────────────────────────────────────────
# Required for dashboard/API login. Configure these as deployment secrets;
# there is deliberately no credential fallback in source.
APEX_ADMIN_PASSWORD=
APEX_ADMIN_TOKEN=

# ─── Agent Behavior ──────────────────────────────────────────────────────────
# strict = gate every agent; normal = role/tool policy (recommended).
APEX_APPROVAL_MODE=normal

# ─── Production Resource Governor ────────────────────────────────────────────
# 0 = no APEX-wide daily token ceiling. Set a positive value when you want a
# deliberate workspace spend ceiling; OpenRouter account controls remain the
# authoritative billing limit.
APEX_TOKEN_CAP_TOTAL=0
# Optional comma-separated caps, e.g. provider:tokens. Leave unset for normal
# paid production operation.
# APEX_TOKEN_CAPS=openrouter-deepseek-pro:5000000
APEX_TOKEN_PACING_ENABLED=true
APEX_TOKEN_PACING_BURST_TOKENS=50000

# ─── Daily REQUEST budget ────────────────────────────────────────────────────
# Separate from the token caps above, and usually the one that actually binds.
# OpenRouter's free allowance is rationed per REQUEST — a fixed number of calls
# per account per UTC day whatever their size — so a workspace can sit far under
# every token cap it owns and still be refused.
#
# 2,600 sits under a three-account free ceiling of 3,000/day (1,000 per account
# once a $10 deposit lifts each off the ~200/day base tier) with headroom for
# requests this ledger cannot see, such as a second revision mid-rollout.
# Set 0 to disable the budget entirely.
APEX_REQUEST_CAP_TOTAL=2600
# Pacing spreads the cap across the UTC day instead of letting the workforce
# spend it all before noon. This is what makes agents wait between turns; it is
# also what makes an exhausted budget a brief pause rather than a dead day.
APEX_REQUEST_PACING_ENABLED=true
# Released immediately at 00:00 UTC so a restart can do real work at once.
APEX_REQUEST_PACING_BURST=150
# Optional per-ACCOUNT caps, keyed by the env var holding each key — that is the
# unit an OpenRouter allowance is charged against, not the provider or model.
# An account that hits its cap steps aside while the others keep serving.
# APEX_REQUEST_CAPS=OPENROUTER_API_KEY:1000,OPENROUTER_API_KEY_2:1000,OPENROUTER_API_KEY_3:1000

# Agents are instructed to batch independent tool calls into one reply, which
# only works if the request permits more than one call per turn. Set to `off`
# if some model ever rejects the parallel_tool_calls field outright.
APEX_PARALLEL_TOOL_CALLS=on

# Six process-wide inference slots across the 13-agent workforce. Lead research
# may use at most three by default; all requests still respect provider pacing,
# circuit breakers, retry-after, and token reservations.
APEX_MAX_CONCURRENT_LLM_CALLS=6
APEX_LEAD_RESEARCH_CONCURRENCY=3
APEX_MAX_OUTPUT_TOKENS=4096
# APEX_MAX_OUTPUT_TOKENS_CEO=8192
# APEX_MAX_OUTPUT_TOKENS_CTO=8192

APEX_SELF_REVIEW=adaptive

# Experimental only. Keep false while the primary production database/runtime
# remains outside the unfinished Convex migration.
APEX_CONVEX_AUTONOMY_ENABLED=false

# ─── Google Cloud Run deployment ─────────────────────────────────────────────
# Fail-closed by default. Setting project/region/service does not itself permit
# a deploy; APEX_DEPLOY_ENABLED must also explicitly authorize the environment.
APEX_DEPLOY_ENABLED=off
APEX_GCP_PROJECT_ID=
APEX_CLOUD_RUN_REGION=
APEX_CLOUD_RUN_SERVICE=
# Optional if Cloud Build uses a regional endpoint.
# APEX_CLOUD_BUILD_REGION=
APEX_DEPLOY_HEALTH_URL=https://apex.donmatthews.live
# Optional clean checkout path used by the deployment CLI.
# APEX_DEPLOY_SOURCE_DIR=/path/to/Apex

# ─── Workspace / Database ────────────────────────────────────────────────────
# WORKSPACE_ROOT=/path/to/workspace
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/apex
DB_LOGGING=false

# ─── Durable artifact store (autonomous-execution scheduler, Phase 1) ─────────
# GCS bucket in the existing GCP project/region (gcloud storage buckets create
# gs://<name> --location=<region>). Names only — real values are operator
# configuration, never guessed. When unset every artifact/workspace tool fails
# closed with an actionable error; the control plane keeps running.
APEX_ARTIFACT_BUCKET=
# Sandbox executor (Phase 4): Cloud Run Jobs resource name. Dispatch loop is a
# no-op until set.
APEX_EXECUTOR_JOB=
# Workstream repo org used by create_github_repo (default patriotnewsactivism).
# APEX_GITHUB_ORG=patriotnewsactivism
# Dynamic-job governance (Phase 5): ceiling for agent-created crons (min 5).
# APEX_MAX_DYNAMIC_JOBS=25
# Executor tuning.
# EXECUTOR_MAX_TURNS=40
# EXECUTOR_TASK_HARD_TIMEOUT_MS=3300000
# EXECUTOR_ALLOW_RUNSHELL=false

# ─── Checkpoint/resume and approval yield (ADR-014) ───────────────────────────
# Fraction of the hard task timeout at which a task must checkpoint and yield
# instead of continuing to burn its execution slot. Clamped to [0.3, 0.95].
# APEX_SOFT_TIMEOUT_RATIO=0.7
# Ordinary (non-executor-job) hard wall-clock timeout override, in ms. The
# executor-job ceiling is EXECUTOR_TASK_HARD_TIMEOUT_MS above.
# APEX_TASK_HARD_TIMEOUT_MS=600000
# How long a gated approval may sit unanswered before it is durably
# auto-rejected (never auto-approved). 0 disables the expiry entirely.
# APEX_APPROVAL_AUTO_REJECT_HOURS=24

# ─── Base44 Superagent Connector (optional) ──────────────────────────────────
# Server-side secret only. Never expose this with VITE_/NEXT_PUBLIC_ prefixes.
# Rotate any key that has been pasted into chat, logs, screenshots, or source.
BASE44_SUPERAGENT_API_KEY=
BASE44_SUPERAGENT_ID=6a515f4e071e32fc10378575
BASE44_SUPERAGENT_TIMEOUT_MS=90000

# ─── BuildMyBot Connector (optional) ─────────────────────────────────────────
# BUILDMYBOT_SUPABASE_URL=
# BUILDMYBOT_SUPABASE_SERVICE_KEY=
# BUILDMYBOT_APP_URL=https://www.buildmybot.app
# BUILDMYBOT_CRON_SECRET=
# BUILDMYBOT_RAILWAY_TOKEN=
# BUILDMYBOT_RAILWAY_SERVICE_ID=60b6d260-f5d8-463d-87be-58339545eaaf
# BUILDMYBOT_RAILWAY_ENVIRONMENT_ID=6ce38db0-789b-4fe9-ad02-f068fe6866ae

# ─── CaseBuddy Connector (optional) ──────────────────────────────────────────
# CASEBUDDY_SUPABASE_URL=
# CASEBUDDY_SUPABASE_SERVICE_KEY=
# CASEBUDDY_APP_URL=https://casebuddy.live
# CASEBUDDY_SYSTEM_USER_ID=

# ─── TubeScribe Connector (optional, read-only monitoring) ───────────────────
# TUBESCRIBE_SUPABASE_URL=
# TUBESCRIBE_SUPABASE_SERVICE_KEY=
# TUBESCRIBE_WORKER_URL=

# ─── Business Search APIs ────────────────────────────────────────────────────
# YELP_API_KEY=
# GOOGLE_PLACES_API_KEY=
# TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=

# ─── GitHub / Business Integrations ──────────────────────────────────────────
# GITHUB_TOKEN=
STRIPE_SECRET_KEY=
# VAPI_API_KEY=
# VAPI_PHONE_NUMBER_ID=
# VAPI_WEBHOOK_SECRET=
# VAPI_WEBHOOK_URL=

# ─── Telnyx Voice (BuildMyBot inbound calls) ─────────────────────────────────
# Required for the Telnyx ↔ Deepgram voice bridge (inbound BuildMyBot calls).
# DEEPGRAM_API_KEY is also used by the /api/transcribe route above.
# TELNYX_API_KEY=
# TELNYX_WEBHOOK_SECRET=          # shared secret verified on every Telnyx webhook
# TELNYX_OWNER_NUMBER=+1xxxxxxxxxx # E.164 number for transfer_to_owner
# TELNYX_MESSAGING_NUMBER=+1xxxxxxxxxx # Telnyx number that sends the SMS checkout link
# PUBLIC_URL=https://apex.donmatthews.live  # base URL for the stream WebSocket

PORT=5000
