# ─── Apex CI/CD Worker — environment configuration ────────────────────────
#
# This process is the one piece of Apex that intentionally stays OFF Convex
# (see convex/cicd.ts on @workspace/convex-backend for the full contract it
# implements). Copy this file to .env.local and fill in real values there —
# .env.local is git-ignored; NEVER commit real secrets in this .env.example.

# ─── Convex deployment (required) ──────────────────────────────────────────
#
# The production Convex deployment this worker polls for jobs. Read from
# packages/convex-backend/.env.local (CONVEX_URL) for the current value —
# do NOT reuse CONVEX_DEPLOY_KEY here, that key is for schema/function
# deploys only and must never live in an always-running worker process.
CONVEX_URL=https://agile-tern-916.convex.cloud

# Shared secret gating claimNextJob/reportJobResult (convex/cicd.ts). Must
# match the value already set on the deployment via:
#   cd packages/convex-backend && npx convex env set CICD_WORKER_SECRET <value>
# Get the actual value from whoever set it / from the team's secret vault —
# do not guess it, and never commit it here.
CICD_WORKER_SECRET=

# ─── GitHub (push / create_pr job types) ───────────────────────────────────
#
# Personal access token used by the push/create_pr job handlers to land
# work via branch-protected PRs. Without it, those two job types return a
# clean { success: false, error: 'GITHUB_TOKEN is not configured...' } result
# instead of throwing. Never commit the real value.
GITHUB_TOKEN=

# ─── Workspace root (read_file/write_file/list_dir/run_shell/run_sandbox/
# git_status/create_branch/push job types) ──────────────────────────────────
#
# Real, persistent git checkout of the Apex repo this worker treats as "the
# workspace" for filesystem + git operations. Defaults to process.cwd() if
# unset, matching the old @workspace/core tool-registry.ts behavior — but
# since this worker is a standalone process that may be launched from
# anywhere (e.g. a Railway service root), set this explicitly in production.
# WORKSPACE_ROOT=C:\path\to\Apex

# ─── CI scratch workspace (test/lint/build job types only) ─────────────────
#
# Separate scratch clone of the Apex repo with FULL devDependencies installed
# (typescript, etc.) — ported from packages/cicd-automation/src/ci-workspace.ts.
# This is deliberately distinct from WORKSPACE_ROOT above: WORKSPACE_ROOT is
# whatever's actually deployed (prod-only install, no devDependencies, so
# `tsc` isn't even present there); this scratch checkout exists purely so
# test/lint/build can run `pnpm run typecheck` / `pnpm run build` against a
# real devDependencies install. Defaults to <os.tmpdir()>/apex-ci-workspace.
# CI_WORKSPACE_ROOT=/tmp/apex-ci-workspace
# CI_REPO_URL=https://github.com/patriotnewsactivism/Apex.git

# ─── Poll loop tuning (optional) ───────────────────────────────────────────
# CICD_WORKER_POLL_INTERVAL_MS=2000
