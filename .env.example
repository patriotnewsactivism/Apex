# ─── APEX Five-Provider Intelligence Stack ────────────────────────────────────
# packages/core/src/llm-client.ts is the source of truth.
# No other inference provider is eligible.
#
# Worker/specialist route:
#   Mistral Medium 3.5 -> Gemini 3.7 Flash -> Cohere Command A+ ->
#   Qwen 3.7 Max -> Kilo Auto Frontier
#
# Manager/executive route (CEO/CTO/COO/Lead Developer/Lead Researcher/QA Director):
#   Gemini 3.7 Flash -> Mistral Medium 3.5 -> Cohere Command A+ ->
#   Qwen 3.7 Max -> Kilo Auto Frontier

# 1) Mistral — primary worker/specialist intelligence.
MISTRAL_API_KEY=

# 2) Gemini — primary manager/executive oversight and delegation.
GEMINI_API_KEY=
# Optional second Google project key; same logical Gemini rung, extra quota.
GEMINI_API_KEY_2=

# 3) Cohere — Command A+.
COHERE_API_KEY=

# 4) Qwen — Qwen 3.7 Max. Model Studio compatible-mode URLs are
# workspace/region specific, so configure the exact base URL from Alibaba.
QWEN_API_KEY=
QWEN_BASE_URL=

# 5) Kilo Code — final fallback through Kilo Auto Frontier.
KILO_API_KEY=

# ─── Agent Behavior ───────────────────────────────────────────────────────────
# strict = gate every agent; normal = role/tool policy (recommended).
# off is rejected at startup so autonomous operation cannot bypass gated tools.
APEX_APPROVAL_MODE=normal

# ─── Resource Governor ────────────────────────────────────────────────────────
# APEX_TOKEN_CAP_TOTAL is a workspace-wide runaway backstop, not a target.
# Keep it ABOVE the desired ~33M Mistral daily allowance so Mistral can use
# that capacity before the workspace pauses. Set 0 to disable only if deliberate.
APEX_TOKEN_CAP_TOTAL=40000000

# Per-provider daily caps count prompt + completion tokens. The requested
# Mistral ceiling is 33M/day. Add caps for other providers only when their
# actual account limits/budgets are known; do not guess them.
APEX_TOKEN_CAPS=mistral:33000000

# Smooth the 13-agent workforce against provider RPM limits.
APEX_MAX_CONCURRENT_LLM_CALLS=3
APEX_MAX_OUTPUT_TOKENS=2048
# APEX_MAX_OUTPUT_TOKENS_CEO=4096

# adaptive reviews prose-only work and unverified delegation without adding an
# extra model call after every task that already executed concrete tools.
APEX_SELF_REVIEW=adaptive

# Experimental only. Keep false while Lightsail/Postgres owns production.
APEX_CONVEX_AUTONOMY_ENABLED=false

# ─── Workspace ────────────────────────────────────────────────────────────────
# WORKSPACE_ROOT=C:\path\to\your\project

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/apex
DB_LOGGING=false

# ─── BuildMyBot Connector (optional) ─────────────────────────────────────────
# BUILDMYBOT_SUPABASE_URL=https://evkjlnbpntimbxklnhoz.supabase.co
# BUILDMYBOT_SUPABASE_SERVICE_KEY=
# BUILDMYBOT_APP_URL=https://www.buildmybot.app
# BUILDMYBOT_CRON_SECRET=
# BUILDMYBOT_VERCEL_DEPLOY_HOOK=

# ─── CaseBuddy Connector (optional) ───────────────────────────────────────────
# CASEBUDDY_SUPABASE_URL=
# CASEBUDDY_SUPABASE_SERVICE_KEY=
# CASEBUDDY_APP_URL=https://casebuddy.live
# CASEBUDDY_SYSTEM_USER_ID=

# ─── TubeScribe Connector (optional, read-only monitoring) ────────────────────
# TUBESCRIBE_SUPABASE_URL=https://wrsrjnqolfytzwbgbkgb.supabase.co
# TUBESCRIBE_SUPABASE_SERVICE_KEY=
# TUBESCRIBE_WORKER_URL=

# ─── Business Search APIs ─────────────────────────────────────────────────────
# YELP_API_KEY=
# GOOGLE_PLACES_API_KEY=
# TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=

# ─── GitHub (engineering loop) ────────────────────────────────────────────────
# GITHUB_TOKEN=

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=

# ─── Vapi.ai — Outbound AI Phone Calls ───────────────────────────────────────
# VAPI_API_KEY=
# VAPI_PHONE_NUMBER_ID=
# VAPI_WEBHOOK_SECRET=
# VAPI_WEBHOOK_URL=

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
